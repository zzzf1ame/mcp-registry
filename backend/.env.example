# MCP Registry 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# 调试模式
DEBUG=true

# 数据库 URL (SQLite 或 PostgreSQL)
# SQLite: sqlite+aiosqlite:///./mcp_registry.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost/mcp_registry
DATABASE_URL=sqlite+aiosqlite:///./mcp_registry.db

# GitHub Token (可选，用于同步 GitHub 数据)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# CORS 允许的源 (JSON 数组格式)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
